---
// 服务端渲染的归档文章列表（替代 client-only 的 ArchivePanel.svelte）
// 全量渲染所有文章，客户端原生 JS 按 ?tag= / ?category= / ?uncategorized 过滤
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getSortedPostsList } from "@utils/content-utils";
import { url } from "@utils/url-utils";

interface PostLike {
	id: string;
	url?: string;
	data: {
		title: string;
		tags?: string[];
		category?: string | null;
		published: Date;
	};
}

interface Group {
	year: number;
	posts: PostLike[];
}

const allPosts = (await getSortedPostsList()) as PostLike[];

// 按发布时间倒序排序
const sorted = allPosts
	.slice()
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

const groupedMap: Record<number, PostLike[]> = {};
for (const post of sorted) {
	const year = post.data.published.getFullYear();
	if (!groupedMap[year]) {
		groupedMap[year] = [];
	}
	groupedMap[year].push(post);
}

const groups: Group[] = Object.keys(groupedMap)
	.map((yearStr) => ({
		year: Number.parseInt(yearStr, 10),
		posts: groupedMap[Number.parseInt(yearStr, 10)],
	}))
	.sort((a, b) => b.year - a.year);

function formatDate(date: Date) {
	const month = (date.getMonth() + 1).toString().padStart(2, "0");
	const day = date.getDate().toString().padStart(2, "0");
	return `${month}-${day}`;
}

function formatTag(tagList: string[]) {
	return tagList.map((t) => `#${t}`).join(" ");
}
---

<div class="card-base px-8 py-6" data-archive-list>
	{
		groups.map((group) => (
			<div data-group-year={group.year}>
				<div class="flex flex-row w-full items-center h-[3.75rem]">
					<div
						class="w-[15%] md:w-[10%] transition text-2xl font-bold text-right text-75"
					>
						{group.year}
					</div>
					<div class="w-[15%] md:w-[10%]">
						<div
							class="h-3 w-3 bg-none rounded-full outline outline-[var(--primary)] mx-auto -outline-offset-[2px] z-50 outline-3"
						></div>
					</div>
					<div class="w-[70%] md:w-[80%] transition text-left text-50">
						<span class="group-count">{group.posts.length}</span>
						{i18n(
							group.posts.length === 1
								? I18nKey.postCount
								: I18nKey.postsCount,
						)}
					</div>
				</div>

				{
					group.posts.map((post) => (
						<a
							href={post.url || url(`/posts/${post.id}/`)}
							aria-label={post.data.title}
							class="group btn-plain !block h-10 w-full rounded-lg hover:text-[initial]"
							data-category={post.data.category ?? ""}
							data-tags={(post.data.tags ?? []).join(",")}
							data-group={group.year}
						>
							<div
								class="flex flex-row justify-start items-center h-full"
							>
								<div
									class="w-[15%] md:w-[10%] transition text-sm text-right text-50"
								>
									{formatDate(post.data.published)}
								</div>

								<div
									class="w-[15%] md:w-[10%] relative dash-line h-full flex items-center"
								>
									<div
										class="transition-all mx-auto w-1 h-1 rounded group-hover:h-5 bg-[oklch(0.5_0.05_var(--hue))] group-hover:bg-[var(--primary)] outline outline-4 z-50 outline-[var(--card-bg)] group-hover:outline-[var(--btn-plain-bg-hover)] group-active:outline-[var(--btn-plain-bg-active)]"
									></div>
								</div>

								<div
									class="w-[70%] md:max-w-[65%] md:w-[65%] text-left font-bold group-hover:translate-x-1 transition-all group-hover:text-[var(--primary)] text-75 pr-8 whitespace-nowrap overflow-ellipsis overflow-hidden"
								>
									{post.data.title}
								</div>

								<div
									class="hidden md:block md:w-[15%] text-left text-sm transition whitespace-nowrap overflow-ellipsis overflow-hidden text-30"
								>
									{formatTag(post.data.tags ?? [])}
								</div>
							</div>
						</a>
					))
				}
			</div>
		))
	}
</div>

<script>
	// 客户端过滤：按 ?tag= / ?category= / ?uncategorized 参数隐藏不符合的文章
	// 与 ArchivePanel.svelte 的过滤语义保持一致
	function filterArchiveList() {
		const list = document.querySelector("[data-archive-list]");
		if (!list) {
			return;
		}

		const params = new URLSearchParams(window.location.search);
		const reqTags = params.getAll("tag");
		const reqCats = params.getAll("category");
		const uncategorized = params.get("uncategorized") !== null;

		const items = list.querySelectorAll("a[data-category]");
		const groups = list.querySelectorAll("[data-group-year]");

		// 无筛选参数时恢复全量显示
		if (reqTags.length === 0 && reqCats.length === 0 && !uncategorized) {
			items.forEach((a) => {
				a.style.display = "";
			});
			groups.forEach((group) => {
				const count = group.querySelector(".group-count");
				if (count) {
					count.textContent = String(
						group.querySelectorAll("a[data-category]").length,
					);
				}
				group.style.display = "";
			});
			return;
		}

		groups.forEach((group) => {
			let visible = 0;
			group.querySelectorAll("a[data-category]").forEach((a) => {
				const postCat = a.getAttribute("data-category") || "";
				const postTags = (a.getAttribute("data-tags") || "")
					.split(",")
					.map((t) => t.trim())
					.filter(Boolean);

				let show = true;
				if (reqTags.length > 0) {
					show = show && postTags.some((t) => reqTags.includes(t));
				}
				if (reqCats.length > 0) {
					show = show && reqCats.includes(postCat);
				}
				if (uncategorized) {
					show = show && postCat === "";
				}
				a.style.display = show ? "" : "none";
				if (show) {
					visible++;
				}
			});

			const count = group.querySelector(".group-count");
			if (count) {
				count.textContent = String(visible);
			}
			group.style.display = visible === 0 ? "none" : "";
		});
	}

	filterArchiveList();
	document.addEventListener("astro:page-load", filterArchiveList);
	document.addEventListener("swup:contentReplaced", filterArchiveList);
</script>
